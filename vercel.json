{
  "rewrites": [
    {
      "source": "/:slug(camp|swimming|caves|views|bluffs|forgotten|frogs|legends|buildings|dead-ends|mud|hiking|popular|rocks|unmarked|yardage)",
      "destination": "/api/category?c=:slug"
