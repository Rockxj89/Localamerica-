{
  "redirects": [
    {
      "source": "/r",
      "destination": "/?s=r",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/:slug(camp|swimming|caves|views|bluffs|forgotten|frogs|legends|buildings|dead-ends|mud|hiking|popular|rocks|wheeling|unmarked|yardage|long-shot)",
      "destination": "/api/category?c=:slug"
    },
    {
      "source": "/places/:slug",
      "destination": "/api/place?s=:slug"
    },
    {
      "source": "/near/:town",
      "destination": "/api/near?t=:town"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    }
  ],
  "functions": {
    "api/category.js": {
      "includeFiles": "index.html"
    }
  },
  "images": {
    "sizes": [
      640,
      1080,
      1600
    ],
    "formats": [
      "image/webp"
    ],
    "minimumCacheTTL": 2678400,
    "remotePatterns": [
      {
        "protocol": "https",
        "hostname": "ycdlxdijrlfsxvxksyrq.supabase.co",
        "pathname": "/storage/v1/object/public/poi-photos/**"
      },
      {
        "protocol": "https",
        "hostname": "thumb.wikimedia.org",
        "pathname": "/wikipedia/commons/thumb/**"
      }
    ]
  }
}
