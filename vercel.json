    "formats": ["image/webp"],
    "minimumCacheTTL": 2678400,
    "remotePatterns": [
      {
        "protocol": "https",
        "hostname": "ycdlxdijrlfsxvxksyrq.supabase.co",
        "pathname": "/storage/v1/object/public/poi-photos/**"
      }
    ]
  }
}
